[
  {
    "app": "youtube",
    "pattern": "(?:search|open|find) (?:youtube|videos?) (?:for )?(?<q>.+)",
    "uri": "https://www.youtube.com/results?search_query={q}",
    "pkg": "com.google.android.youtube"
  },
  {
    "app": "maps",
    "pattern": "(?:navigate to|directions to) (?<q>.+)",
    "uri": "google.navigation:q={q}",
    "pkg": "com.google.android.apps.maps"
  },
  {
    "app": "maps",
    "pattern": "(?:find|show) (?<q>.+) on maps",
    "uri": "geo:0,0?q={q}",
    "pkg": "com.google.android.apps.maps"
  },
  {
    "app": "playstore",
    "pattern": "(?:find|install|download) (?<q>.+) on (?:play store|google play)",
    "uri": "market://search?q={q}",
    "pkg": "com.android.vending"
  },
  {
    "app": "chrome",
    "pattern": "(?:search|google) (?:the web |google )?(?:for )?(?<q>.+)",
    "uri": "https://www.google.com/search?q={q}",
    "pkg": "com.android.chrome"
  }
]
